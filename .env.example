# PracticeSpeak AI — configuración por entorno (copia a .env o exporta antes de arrancar) — PracticeSpeak AI

# Perfil de recursos: low (8 GB sin GPU) | high. Vacío = autodetectado por RAM
NOVA_PROFILE=

# Ollama / LLM
NOVA_OLLAMA_BASE_URL=http://127.0.0.1:11434
NOVA_OLLAMA_MODEL=qwen3:4b
NOVA_OLLAMA_TIMEOUT=180

# Whisper (tiny|base|small|medium|large-v3)
NOVA_WHISPER_MODEL=medium

# TTS: piper (local, cae a edge si falla — recomendado) | edge (requiere internet)
# Para piper instala el binario en el mismo entorno: pip install piper-tts
# (se busca en PATH y en .venv/bin aunque el venv no esté activado).
NOVA_TTS_BACKEND=piper
# Carpeta donde piper guarda las voces descargadas bajo demanda
NOVA_PIPER_HOME=$HOME/.local/share/nova/piper

# Servidor
NOVA_HOST=0.0.0.0
NOVA_PORT=8000
NOVA_HTTPS_PORT=8443

# Hostname público HTTPS (para redirección automática al abrir por HTTP).
# Ejemplo Tailscale: nova-tutor.taile42733.ts.net
NOVA_PUBLIC_HOSTNAME=

# CORS: orígenes permitidos (separados por coma). Vacío = permite todos (desarrollo).
# En producción, especificar dominios: "https://example.com,https://app.example.com"
NOVA_CORS_ORIGINS=

# --- Compartir PracticeSpeak AI por URL con amigos -------------------------------------

# Código compartido: si lo defines, toda petición a /api lo pedirá en una
# pantalla antes de entrar (se recuerda en cada dispositivo). Ej.: nova2026
NOVA_ACCESS_CODE=

# Conversaciones simultáneas máximas (protege la CPU con varias personas a la vez)
NOVA_MAX_CONCURRENT_STREAMS=2

# Peticiones por IP y minuto en endpoints caros (chat, tts, audio). 0 = sin límite
NOVA_RATE_LIMIT_PER_MINUTE=30

# Carpeta de datos persistentes (base SQLite fuera de /tmp)
NOVA_DATA_DIR=$HOME/.local/share/nova

# Binarios y logs usados por run.sh
NOVA_OLLAMA_BIN=$HOME/.local/bin/ollama
NOVA_LOG_DIR=/tmp/nova
